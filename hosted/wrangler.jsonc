{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "career-compass-memory",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Fill both ids after `npx wrangler d1 create` / `npx wrangler kv namespace create` (see DEPLOY.md).
  "d1_databases": [
    { "binding": "DB", "database_name": "career-compass-memory", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }],
  // Daily: delete records idle for 12 months (the privacy promise).
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": { "PUBLIC_URL": "https://memory.careercompass.example" }
  // Secrets (npx wrangler secret put NAME): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CARD_KEY
}
